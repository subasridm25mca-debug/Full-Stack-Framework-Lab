<!DOCTYPE html>
<html>
<head>
    <title>Library Request Portal</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container">

    <h1>📚 Smart Library Request Portal</h1>

    <form action="/submit" method="POST">

        <input type="text"
               name="studentName"
               placeholder="Student Name"
               required>

        <input type="text"
               name="bookName"
               placeholder="Book Name"
               required>

        <input type="text"
               name="author"
               placeholder="Author Name"
               required>

        <input type="date"
               name="requestDate"
               required>

        <button type="submit">
            Request Book
        </button>

    </form>

</div>

</body>
</html>
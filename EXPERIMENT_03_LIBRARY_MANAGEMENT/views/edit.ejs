<!DOCTYPE html>
<html>
<head>
    <title>Edit Book</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container mt-5">
    <div class="card p-4 shadow mx-auto" style="max-width:500px;">
        <h2 class="text-center text-primary mb-4">Edit Book</h2>

        <form action="/edit/<%= book._id %>?_method=PUT" method="POST">

            <input type="text" name="title" class="form-control mb-3" value="<%= book.title %>" required>

            <input type="text" name="author" class="form-control mb-3" value="<%= book.author %>" required>

            <input type="text" name="genre" class="form-control mb-3" value="<%= book.genre %>" required>

            <select name="status" class="form-control mb-3">
                <option <%= book.status=="Available" ? "selected" : "" %>>Available</option>
                <option <%= book.status=="Issued" ? "selected" : "" %>>Issued</option>
            </select>

            <button class="btn btn-primary w-100">Update Book</button>

        </form>

        <a href="/" class="btn btn-secondary mt-3">Back</a>
    </div>
</div>

</body>
</html>
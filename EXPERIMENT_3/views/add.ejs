<!DOCTYPE html>
<html>
<head>
    <title>Add Book</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container mt-5">
    <div class="card p-4 shadow mx-auto" style="max-width:500px;">
        <h2 class="text-center text-primary mb-4">Add Book</h2>

        <form action="/add" method="POST">

            <input type="text" name="title" class="form-control mb-3" placeholder="Book Title" required>

            <input type="text" name="author" class="form-control mb-3" placeholder="Author" required>

            <input type="text" name="genre" class="form-control mb-3" placeholder="Genre" required>

            <select name="status" class="form-control mb-3">
                <option>Available</option>
                <option>Issued</option>
            </select>

            <button class="btn btn-success w-100">Add Book</button>

        </form>

        <a href="/" class="btn btn-secondary mt-3">Back</a>
    </div>
</div>

</body>
</html>
<!DOCTYPE html>
<html>
<head>
    <title>Library Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<div class="container mt-5">
    <h2 class="text-center text-primary mb-4">📚 Library Management System</h2>

    <a href="/add" class="btn btn-success mb-3">+ Add Book</a>

    <table class="table table-bordered table-hover text-center">
        <tr class="table-dark">
            <th>Title</th>
            <th>Author</th>
            <th>Genre</th>
            <th>Status</th>
            <th>Action</th>
        </tr>

        <% books.forEach(book=>{ %>
        <tr>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td><%= book.genre %></td>
            <td><%= book.status %></td>
            <td>
                <a href="/edit/<%= book._id %>" class="btn btn-warning btn-sm">Edit</a>

                <form action="/delete/<%= book._id %>?_method=DELETE" method="POST" style="display:inline;">
                    <button class="btn btn-danger btn-sm">Delete</button>
                </form>
            </td>
        </tr>
        <% }) %>

    </table>
</div>

</body>
</html>
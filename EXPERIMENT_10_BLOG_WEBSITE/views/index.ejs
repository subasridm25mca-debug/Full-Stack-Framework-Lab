<!DOCTYPE html>
<html>
<head>
    <title>My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="container">
        <h1>My Blog</h1>

        <a href="/admin">Admin Panel</a>

        <% posts.forEach(post => { %>

            <div class="post">
                <h2><%= post.title %></h2>
                <p><%= post.content %></p>
            </div>

        <% }) %>

    </div>

</body>
</html>